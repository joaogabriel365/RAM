# Copie para backend/.env e ajuste.

# true = robô simulado (sem ESP32). No robô de verdade, deixe false.
MOCK_ROBOT=true

# Porta serial do ESP32: /dev/ttyUSB0 ou /dev/ttyACM0 no Linux, COM3 (etc.) no Windows.
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200

# TROQUE esta senha antes de levar o robô para qualquer lugar.
ADMIN_USER=admin
ADMIN_PASSWORD=ram-admin

HOST=0.0.0.0
PORT=8000

# Opcional: URL que o QR code do rosto mostra (ex.: http://ram.local:8000).
# Vazio = usa o IP da rede automaticamente.
PUBLIC_URL=

# Minutos sem interação até o rosto dormir (0 = nunca). Valor inicial.
REST_MINUTES=5
